# --- Entorno ---
# Producción: DEBUG=False. Desarrollo local: DEBUG=True
DEBUG=False

# Hosts permitidos (separados por coma). En la VPS incluir el dominio y/o la IP pública.
# Ejemplo: ALLOWED_HOSTS=midominio.com,www.midominio.com,203.0.113.10
ALLOWED_HOSTS=localhost,127.0.0.1

# Orígenes de confianza para CSRF (separados por coma, incluyendo el esquema).
# Ejemplo HTTPS: https://midominio.com,https://www.midominio.com
# Ejemplo HTTP:  http://midominio.com,http://203.0.113.10
CSRF_TRUSTED_ORIGINS=

# Configuración de Base de Datos
DB_HOST=localhost
DB_NAME=cibercafe_db
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_PORT=3306

# Clave de Seguridad
SECRET_KEY_TOKEN=

# Configuración Regional
TIME_ZONE=America/El_Salvador
LANGUAGE_CODE=es-sv

# Configuración de Envío de Facturas por Correo (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=thecoffeelan@gmail.com
EMAIL_HOST_PASSWORD=tu_clave_de_aplicacion_gmail_aqui (pedir al grupo)
DEFAULT_FROM_EMAIL=thecoffeelan@gmail.com
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

# --- Seguridad HTTPS / HTTP (solo se aplican cuando DEBUG=False) ---
# Con HTTPS (recomendado): SESSION_COOKIE_SECURE=True, CSRF_COOKIE_SECURE=True,
#                          SECURE_HSTS_SECONDS=31536000
# Con HTTP (sin TLS):      SESSION_COOKIE_SECURE=False, CSRF_COOKIE_SECURE=False,
#                          SECURE_HSTS_SECONDS=0
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
# Redirige todo a HTTPS. Déjalo en False si nginx ya hace la redirección.
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
